{
  "name": "fluentpath-ielts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts --local\" \"vite --host 127.0.0.1\"",
    "dev:spa": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:worker": "node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "mentor:local": "npm run build -- --base / --mode chatgpt-local && tsx server/index.ts --chatgpt-local",
    "local": "npm run mentor:local",
    "setup:mac": "bash scripts/setup-local-macos.sh",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "express": "^5.1.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "use-webmcp-tool": "^0.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
