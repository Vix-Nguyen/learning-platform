# Optional API server settings. Local development defaults to 127.0.0.1:8787 without sign-in.
HOST=127.0.0.1
PORT=8787
APP_BASE_PATH=/

# Set all three to enable password sign-in. Required for production or non-loopback hosts.
AUTH_USERNAME=learner
AUTH_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional OpenAI-compatible provider. Keep these on the server; never use VITE_ prefixes.
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=replace-with-provider-key
# LLM_MODEL=model-name
